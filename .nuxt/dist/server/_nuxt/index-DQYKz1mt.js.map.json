,oBAAoB,MAAM;AAC9B,QAAI,cAAc,OAAO;AACvB,oBAAc,MAAM,MAAM,YAAY,cAAc,iBAAiB,KAAK;AAAA,IAC5E;AAAA,EACF;AAEA,QAAM,aAAa,CAAC,UAAmC;AACrD,eAAW,QAAQ;AACnB,aAAS,QAAQ,aAAa,KAAK;AACnC,QAAI,cAAc,OAAO;AACvB,oBAAc,MAAM,MAAM,aAAa;AAAA,IACzC;AAAA,EACF;AAEA,QAAM,YAAY,CAAC,UAAmC;AACpD,QAAI,CAAC,WAAW,MAAO;AACvB,UAAM,kBAAkB,aAAa,KAAK;AAC1C,qBAAiB,QAAQ,cAAc,QAAQ,kBAAkB,SAAS;AAC1E,sBAAA;AAAA,EACF;AAEA,QAAM,WAAW,MAAM;AACrB,eAAW,QAAQ;AACnB,UAAM,UAAU,iBAAiB,QAAQ,cAAc;AAEvD,QAAI,UAAU,QAAQ,aAAa,QAAQ,4BAA4B,SAAS;AAChF,QAAI,UAAU,OAAO,aAAa,QAAQ,gBAAgB,SAAS;AAEnE,QAAI,cAAc,OAAO;AACvB,oBAAc,MAAM,MAAM,aAAa;AAAA,IACzC;AACA,uBAAA;AAAA,EACF;AAEA,QAAM,eAAe,CAAC,UAAmC;AACvD,WAAO,MAAM,KAAK,SAAS,OAAO,IAAK,MAAqB,QAAS,MAAqB,QAAQ,CAAC,EAAE;AAAA,EACvG;AAEA,QAAM,OAAO,MAAM;AACjB,QAAI,aAAa,QAAQ,eAAe;AACtC,mBAAa,SAAS;AACtB,yBAAA;AAAA,IACF;AAAA,EACF;AAEA,QAAM,OAAO,MAAM;AACjB,QAAI,aAAa,QAAQ,GAAG;AAC1B,mBAAa,SAAS;AACtB,yBAAA;AAAA,IACF;AAAA,EACF;AAEA,QAAM,OAAO,CAAC,UAAkB;AAC9B,iBAAa,QAAQ;AACrB,uBAAA;AAAA,EACF;AAmBA,SAAO;AAAA,IACL;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,IACA;AAAA,EAAA;AAEJ;;;;;;;;;;;;AC7HO,YAAA,OAAAM,eAAAC,WAAA,EAAA,OAAM,0BAAsB,MAAA,CAAA,CAAA,gFAAA;AAGoBH,oBAAA,QAAA,QAAQ,KAAK,cAApB,QAAG;iEAA4C,GAAG,CAAA,SAAA;AAAA;AAExD,YAAA,kDAAAJ,eAAA,QAAA,QAAQ,KAAK,CAAA,OAAA;;QACtC,IAAE,aAAe,QAAA,QAAQ,IAAI;AAAA,QAAI,OAAM;AAAA,MAAA;yBAAlD,CAGW,GAAAE,QAAAC,UAAA,aAAA;;;;;;8BAH6D,eAEtE;AAAA,cAAAK,YAAyB,gCAAA;AAAA,YAAA;AAAA;;;;;;QAIjB,KAAK,QAAA,QAAQ;AAAA,QAAQ,KAAK,QAAA,QAAQ;AAAA,QAAO,SAAQ;AAAA,MAAA;;;;;;;;;;;;;;;AC0BjE,UAAM,WAAW;AACjB,UAAM,EAAE,cAAgF,aAAA,IAAiB,YAAY,SAAS,MAAM;;;;QAvCzH,OAAM;AAAA,QAAW,IAAG;AAAA,MAAA;;;AAQH,YAAAC,mBAAA,6BAAA,EAAA,OAAM,gBAAY,MAAA,OAAA,CAAA;;AAOQL,oBAAAH,MAAA,QAAA,IAAX,YAAO;;AAC1B,cAAAQ,mBAAAC,aAAA,EAAA,WAAgB,MAAA,OAAA,CAAA;;;;oBAQX,KAAK,IAAG,GAAIT,MAAA,QAAA,EAAS,SAASA,MAAA,YAAA,IAAY,CAAA,GAAA,CAAvD,GAAG,UAAK;AAEE,cAAA,kBAAAI,eAAA,CAAA,EAAA,QAAAJ,MAAA,YAAA,MAAiB,MAAA,GAAK,eAAA,CAAA,CAAA,6BAAA;AAAA;;;;;;;;;;;;;;;;ACKhD,UAAM,WAAW;;;;;QA/BN,OAAM;AAAA,QAAU,IAAG;AAAA,MAAA;AASLG,oBAAAH,MAAA,QAAA,IAAR,SAAI;iCAEV,QAAM,KAAK,IAAI,IACfU,cAAA,UAAQ,KAAK,wBAAwB,MAAS;;UAInC,KAAK,KAAK;AAAA,UAAO,KAAK,KAAK;AAAA,QAAA;4FAGGX,eAAA,KAAK,QAAQ,8CACfA,eAAA,KAAK,MAAM;AAE5B,cAAAS,mBAAA,kCAAA,EAAA,OAAM,yBAAqB,MAAA,OAAA,CAAA;;;;;;;;;;;;;;;;;ACZ5D,eAAW;AAAA,MACT,OAAO;AAAA,MACP,aAAa;AAAA,MACb,SAAS;AAAA,MACT,eAAe;AAAA,MACf,SAAS;AAAA,MACT,QAAQ;AAAA,IAAA,CACT;;;;;;;;;;;;;;;;;;;;;;;","names":["_ssrInterpolate","_unref","_push","_parent","_ssrRenderList","_ssrRenderClass","_ssrRenderAttrs","_mergeProps","_createVNode","_ssrRenderComponent","ProjectCard","_ssrRenderAttr"],"sources":["../../../../components/HeroSection.vue","../../../../components/ExperienceSection.vue","../../../../components/SkillsSection.vue","../../../../composables/useCarousel.ts","../../../../components/ProjectCard.vue","../../../../components/ProjectsCarousel.vue","../../../../components/ContactSection.vue","../../../../pages/index.vue"],"sourcesContent":["<template>\n  <section class=\"hero\" id=\"inicio\">\n    <div class=\"hero__photo\">\n      <NuxtImg src=\"/img/bg_sobre.png\" alt=\"Emilly Miller Photo\" />\n    </div>\n\n    <div class=\"hero__content\">\n      <div class=\"hero__badge\">\n        <span class=\"hero__badge-wave\">👋</span> HELLO!\n      </div>\n      <h1 class=\"hero__title\">\n        I'm <span>{{ profile.name }}</span>,<br>\n        {{ profile.role }}\n      </h1>\n\n      <div class=\"hero__cta\">\n        <div class=\"hero__buttons\">\n          <NuxtLink to=\"#servicesCarousel\" class=\"btn btn--primary\">Portfólio</NuxtLink>\n          <NuxtLink to=\"#contato\" class=\"btn btn--secondary\">Contato</NuxtLink>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"hero__testimonials\">\n      <p class=\"hero__testimonial-text\">\n        \"{{ profile.testimonial.replace(/\\n/g, ' ') }}\"\n      </p>\n    </div>\n\n    <div class=\"hero__experience\">\n      <span class=\"hero__experience-number\">{{ profile.yearsExperience }}</span>\n      <span class=\"hero__experience-text\">{{ profile.experienceLabel }}</span>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nimport { PROFILE } from '~/data/portfolio'\nconst profile = PROFILE\n</script>\n","<template>\n  <section class=\"experience\" id=\"trajetoria\">\n    <h2 class=\"experience__title\">Minha Trajetória</h2>\n    \n    <div class=\"experience__timeline\">\n      <div class=\"experience__item\" v-for=\"item in timeline\" :key=\"item.company\">\n        <div class=\"experience__dot\" :class=\"`experience__dot--${item.dotColor}`\"></div>\n        <div class=\"experience__content\">\n          <div class=\"experience__header\">\n            <div class=\"experience__company-info\">\n              <NuxtImg :src=\"item.logo\" :alt=\"`${item.company} logo`\" class=\"experience__logo\" />\n              <h3 class=\"experience__company\">{{ item.company }}</h3>\n            </div>\n            <span class=\"experience__period\">{{ item.period }}</span>\n          </div>\n          <h4 class=\"experience__role\">{{ item.role }}</h4>\n          <p class=\"experience__desc\">{{ item.description }}</p>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nimport { TIMELINE } from '~/data/portfolio'\nconst timeline = TIMELINE\n</script>\n","<template>\n  <section class=\"hire\" id=\"contratar\">\n    <div class=\"hire__container\">\n      <div class=\"hire__header\">\n        <h2 class=\"hire__title\">Minhas Stacks</h2>\n        <p class=\"hire__subtitle\">Ferramentas e tecnologias que utilizo para criar soluções digitais.</p>\n        <NuxtLink :to=\"resumeUrl\" target=\"_blank\" class=\"btn btn--primary hire__btn\">Visualizar Currículo</NuxtLink>\n      </div>\n\n      <div class=\"hire__skills\">\n        <div class=\"hire__skills-group\" v-for=\"group in skillGroups\" :key=\"group.label\">\n          <h3 class=\"hire__skills-label\">{{ group.label }}</h3>\n          <div class=\"hire__skills-tags\">\n            <div class=\"hire__skill-tag\" v-for=\"skill in group.skills\" :key=\"skill.name\">\n              <NuxtImg :src=\"skill.icon\" :alt=\"skill.name\" class=\"hire__skill-icon\" />\n              {{ skill.name }}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nimport { SKILL_GROUPS, PROFILE } from '~/data/portfolio'\nconst skillGroups = SKILL_GROUPS\nconst resumeUrl = PROFILE.resumeUrl\n</script>\n","import { ref, onMounted, onUnmounted, type Ref } from 'vue'\n\nexport function useCarousel(totalItems: number) {\n  const currentIndex = ref(0)\n  const isDragging = ref(false)\n  const startPos = ref(0)\n  const currentTranslate = ref(0)\n  const prevTranslate = ref(0)\n  const carouselTrack = ref<HTMLElement | null>(null)\n  \n  const cardsPerView = ref(1)\n\n  const updateCardsPerView = () => {\n    if (window.innerWidth >= 1300) cardsPerView.value = 3\n    else if (window.innerWidth >= 1024) cardsPerView.value = 2\n    else if (window.innerWidth >= 768) cardsPerView.value = 2\n    else cardsPerView.value = 1\n  }\n\n  const getMaxIndex = () => {\n    return Math.max(0, totalItems - cardsPerView.value)\n  }\n\n  const setPositionByIndex = () => {\n    const maxIndex = getMaxIndex()\n    if (currentIndex.value > maxIndex) currentIndex.value = maxIndex\n    if (currentIndex.value < 0) currentIndex.value = 0\n    \n    // Each card is usually ~380px or based on flex-basis.\n    // In original code, the calculation used offsetWidth and gap\n    if (carouselTrack.value && carouselTrack.value.children.length > 0) {\n      const card = carouselTrack.value.children[0] as HTMLElement\n      const gap = parseInt(window.getComputedStyle(carouselTrack.value).gap) || 20\n      const moveAmount = card.offsetWidth + gap\n      currentTranslate.value = currentIndex.value * -moveAmount\n      prevTranslate.value = currentTranslate.value\n      setSliderPosition()\n    }\n  }\n\n  const setSliderPosition = () => {\n    if (carouselTrack.value) {\n      carouselTrack.value.style.transform = `translateX(${currentTranslate.value}px)`\n    }\n  }\n\n  const touchStart = (event: TouchEvent | MouseEvent) => {\n    isDragging.value = true\n    startPos.value = getPositionX(event)\n    if (carouselTrack.value) {\n      carouselTrack.value.style.transition = 'none'\n    }\n  }\n\n  const touchMove = (event: TouchEvent | MouseEvent) => {\n    if (!isDragging.value) return\n    const currentPosition = getPositionX(event)\n    currentTranslate.value = prevTranslate.value + currentPosition - startPos.value\n    setSliderPosition()\n  }\n\n  const touchEnd = () => {\n    isDragging.value = false\n    const movedBy = currentTranslate.value - prevTranslate.value\n    \n    if (movedBy < -100 && currentIndex.value < getMaxIndex()) currentIndex.value += 1\n    if (movedBy > 100 && currentIndex.value > 0) currentIndex.value -= 1\n\n    if (carouselTrack.value) {\n      carouselTrack.value.style.transition = 'transform 0.3s ease-out'\n    }\n    setPositionByIndex()\n  }\n\n  const getPositionX = (event: TouchEvent | MouseEvent) => {\n    return event.type.includes('mouse') ? (event as MouseEvent).pageX : (event as TouchEvent).touches[0].clientX\n  }\n\n  const next = () => {\n    if (currentIndex.value < getMaxIndex()) {\n      currentIndex.value += 1\n      setPositionByIndex()\n    }\n  }\n\n  const prev = () => {\n    if (currentIndex.value > 0) {\n      currentIndex.value -= 1\n      setPositionByIndex()\n    }\n  }\n  \n  const goTo = (index: number) => {\n    currentIndex.value = index;\n    setPositionByIndex()\n  }\n\n  onMounted(() => {\n    updateCardsPerView()\n    window.addEventListener('resize', () => {\n      updateCardsPerView()\n      setPositionByIndex()\n    })\n    \n    // Allow slight delay for DOM to settle sizes\n    setTimeout(() => {\n      setPositionByIndex()\n    }, 100)\n  })\n\n  onUnmounted(() => {\n    window.removeEventListener('resize', updateCardsPerView)\n  })\n\n  return {\n    currentIndex,\n    carouselTrack,\n    touchStart,\n    touchMove,\n    touchEnd,\n    next,\n    prev,\n    goTo,\n    cardsPerView,\n    getMaxIndex\n  }\n}\n","<template>\n  <div class=\"services__card-inner\">\n    <div class=\"services__card-content\">\n      <div class=\"services__card-tags\">\n        <span class=\"services__card-tag\" v-for=\"tag in project.tags.slice(0, 2)\" :key=\"tag\">{{ tag }}</span>\n      </div>\n      <h3 class=\"services__card-title\">{{ project.title }}</h3>\n      <NuxtLink :to=\"`/projetos/${project.slug}`\" class=\"services__card-link\">\n        Ver Projeto\n        <IconsIconArrowUpRight />\n      </NuxtLink>\n    </div>\n    <div class=\"services__card-image\">\n      <NuxtImg :src=\"project.image\" :alt=\"project.title\" loading=\"lazy\" />\n    </div>\n  </div>\n</template>\n\n<script setup lang=\"ts\">\nimport type { Project } from '~/types/portfolio'\n\ndefineProps<{\n  project: Project\n}>()\n</script>\n","<template>\n  <section class=\"services\" id=\"servicesCarousel\">\n    <div class=\"services__header\">\n      <h2 class=\"services__title\">Meus Projetos Recentes</h2>\n      <div class=\"services__controls\">\n        <button class=\"services__control-btn prev\" @click=\"prev\" aria-label=\"Previous\">\n          <IconsIconChevron />\n        </button>\n        <button class=\"services__control-btn next\" @click=\"next\" aria-label=\"Next\">\n          <IconsIconChevron class=\"rotate-180\" />\n        </button>\n      </div>\n    </div>\n\n    <div class=\"services__carousel\">\n      <div class=\"services__track\" ref=\"carouselTrack\" @touchstart=\"touchStart\" @touchmove=\"touchMove\" @touchend=\"touchEnd\" @mousedown=\"touchStart\" @mousemove=\"touchMove\" @mouseup=\"touchEnd\" @mouseleave=\"touchEnd\">\n        <div class=\"services__card\" v-for=\"project in projects\" :key=\"project.slug\">\n          <ProjectCard :project=\"project\" />\n        </div>\n      </div>\n    </div>\n\n    <div class=\"services__dots\">\n      <button \n        class=\"services__dot\" \n        v-for=\"(_, index) in Math.max(1, projects.length - cardsPerView + 1)\" \n        :key=\"index\"\n        :class=\"{ active: currentIndex === index }\"\n        @click=\"goTo(index)\"\n      ></button>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nimport { PROJECTS } from '~/data/portfolio'\nimport { useCarousel } from '~/composables/useCarousel'\nimport ProjectCard from '~/components/ProjectCard.vue'\n\nconst projects = PROJECTS\nconst { currentIndex, carouselTrack, touchStart, touchMove, touchEnd, next, prev, goTo, cardsPerView } = useCarousel(projects.length)\n</script>\n\n<style scoped>\n.rotate-180 {\n  transform: rotate(180deg);\n}\n</style>\n","<template>\n  <section class=\"contact\" id=\"contato\">\n    <div class=\"contact__container\">\n      <div class=\"contact__content\">\n        <h2 class=\"contact__title\">Vamos trabalhar juntos!</h2>\n        <p class=\"contact__desc\">Estou disponível para novos projetos e oportunidades. Entre em contato através de uma das plataformas abaixo.</p>\n      </div>\n      \n      <div class=\"contact__links\">\n        <a \n          v-for=\"link in contacts\" \n          :key=\"link.platform\"\n          :href=\"link.href\" \n          :target=\"link.isExternal ? '_blank' : undefined\"\n          class=\"contact__card\"\n        >\n          <div class=\"contact__card-icon\">\n            <NuxtImg :src=\"link.icon\" :alt=\"link.platform\" />\n          </div>\n          <div class=\"contact__card-info\">\n            <span class=\"contact__card-platform\">{{ link.platform }}</span>\n            <span class=\"contact__card-handle\">{{ link.handle }}</span>\n          </div>\n          <IconsIconArrowUpRight class=\"contact__card-arrow\" />\n        </a>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nimport { CONTACTS } from '~/data/portfolio'\nconst contacts = CONTACTS\n</script>\n","<template>\n  <main>\n    <HeroSection />\n    <ExperienceSection />\n    <SkillsSection />\n    <ProjectsCarousel />\n    <ContactSection />\n  </main>\n</template>\n\n<script setup lang=\"ts\">\nuseSeoMeta({\n  title: 'Portfólio | Emilly Miller',\n  description: 'Portfólio de Emilly Miller, Desenvolvedora Web Front-end. Transformo designs complexos do Figma em código de alta qualidade e performance.',\n  ogTitle: 'Portfólio | Emilly Miller',\n  ogDescription: 'Portfólio de Emilly Miller, Desenvolvedora Web Front-end.',\n  ogImage: '/img/miller.png',\n  ogType: 'website',\n})\n</script>\n"],"version":3}